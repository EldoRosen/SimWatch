<UserControl x:Class="SimWatch.SimWatchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="NumberBox" TargetType="TextBox">
            <Setter Property="Width" Value="90" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,2,12,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock x:Name="ProfilerStatusText" FontWeight="SemiBold" Margin="2,0,2,8" TextWrapping="Wrap" />

            <GroupBox Header="Sim speed check" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Margin="2,2,2,6"
                              Content="Enable automatic checks" IsChecked="{Binding Enabled}" />

                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Run diagnostics below sim speed"
                               ToolTip="1.0 = full speed. Diagnostics only ever run when the average is below this." />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}"
                             Text="{Binding SimSpeedThreshold}" />

                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Average sim speed over (seconds)"
                               ToolTip="One reading per second; the average is compared to the threshold." />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource NumberBox}"
                             Text="{Binding SampleSeconds}" />

                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Timer: check every (minutes, 0 = no timer)"
                               ToolTip="Optional. With 0 there is no timed check; use the live monitor below or the !simwatch commands." />
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource NumberBox}"
                             Text="{Binding CheckIntervalMinutes}" />

                    <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Margin="2,6,2,2"
                              Content="Live monitor: run diagnostics as soon as the average drops below the threshold"
                              ToolTip="Watches the sim speed every second; needs no timer."
                              IsChecked="{Binding LiveMonitorEnabled}" />

                    <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Live monitor: pause after a run (minutes)"
                               ToolTip="Minimum time between the end of one automatic live run and the next." />
                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource NumberBox}"
                             Text="{Binding LiveCooldownMinutes}" />

                    <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Extra wait per command (seconds)"
                               ToolTip="Added to each command's own duration before it is considered timed out." />
                    <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource NumberBox}"
                             Text="{Binding CommandGraceSeconds}" />

                    <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="Keep this many reports" />
                    <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource NumberBox}"
                             Text="{Binding MaxReports}" />

                    <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="Delete reports older than (days, 0 = keep)"
                               ToolTip="Saved report files in SimWatch-Reports older than this are deleted automatically." />
                    <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource NumberBox}"
                             Text="{Binding ReportRetentionDays}" />

                    <TextBlock Grid.Row="9" Style="{StaticResource Label}" Text="Show top results per profile command (0 = all)"
                               ToolTip="Grids, block types, scripts etc. are cut to this many entries in the report and the Discord post." />
                    <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource NumberBox}"
                             Text="{Binding MaxResultLines}" />

                    <TextBlock Grid.Row="10" Style="{StaticResource Label}" Text="Sector name (shown in reports, optional)"
                               ToolTip="Appears in the saved report and the Discord post. Leave empty to hide it." />
                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding SectorName}" Width="220" Margin="2"
                             HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="11" Style="{StaticResource Label}" Text="Repeat offender: compare last (alerts, 0 = off)"
                               ToolTip="Flags a grid, script or player that was the top result in 2 or more of the latest alerts (this one included)." />
                    <TextBox Grid.Row="11" Grid.Column="1" Style="{StaticResource NumberBox}"
                             Text="{Binding RepeatLookbackAlerts}" />

                    <TextBlock Grid.Row="12" Style="{StaticResource Label}" Text="Repeat offender: only alerts from the last (days)"
                               ToolTip="Older alerts are ignored for the comparison." />
                    <TextBox Grid.Row="12" Grid.Column="1" Style="{StaticResource NumberBox}"
                             Text="{Binding RepeatWindowDays}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Diagnostic commands" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="2,0,2,6"
                               Text="One command per line, run in this order (include the ! prefix). Press Tab or click elsewhere to apply." />
                    <TextBox Text="{Binding DiagnosticCommandsText}" AcceptsReturn="True" AcceptsTab="False"
                             MinHeight="150" MaxHeight="300" FontFamily="Consolas" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    <CheckBox Margin="2,8,2,2" IsChecked="{Binding InspectSmallClusters}"
                              Content="After '!profile physics': if the top cluster (index 0) is small, also run '!profile physics --inspect=0'" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Small means fewer than (entities)" />
                        <TextBox Style="{StaticResource NumberBox}" Text="{Binding InspectEntityThreshold}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Concealment" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="ConcealStatusText" FontWeight="SemiBold" Margin="2,0,2,6" TextWrapping="Wrap" />
                    <CheckBox x:Name="ConcealCheckBox" Margin="2,2,2,2" IsChecked="{Binding ConcealAfterDiagnostics}"
                              Content="After a diagnostics run caused by low sim speed, also run this command:"
                              ToolTip="Only runs when the Concealment plugin is installed. The output is added to the report." />
                    <TextBox Text="{Binding ConcealCommand}" Width="220" HorizontalAlignment="Left" Margin="2,4,2,2"
                             FontFamily="Consolas" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Discord" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <CheckBox Margin="2,2,2,6" IsChecked="{Binding DiscordEnabled}"
                              Content="Post the report to Discord when diagnostics finish" />
                    <TextBlock Style="{StaticResource Label}" Text="Webhook URL (keep private)" />
                    <TextBox Text="{Binding DiscordWebhookUrl}" Margin="2" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Bot name" />
                        <TextBox Text="{Binding DiscordUsername}" Width="200" Margin="2" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Ping role ID (optional)"
                                   ToolTip="Pings this role on sim speed alerts (not on manual scans). Leave empty for no ping. The test message pings it too." />
                        <TextBox Text="{Binding DiscordPingRoleId}" Width="200" Margin="2" FontFamily="Consolas"
                                 ToolTip="The role's numeric ID, not its name: in Discord turn on Developer Mode, then right-click the role (Server Settings > Roles) > Copy Role ID." />
                    </StackPanel>
                    <CheckBox Margin="2,6,2,2" IsChecked="{Binding SkipDiscordWhenRecovered}"
                              Content="Don't post alert reports when the sim speed is back at 1.00 at the end"
                              ToolTip="The report is still saved. Only alerts that end below 1.00 are posted. Manual scans always post." />
                    <CheckBox Margin="2,6,2,2" IsChecked="{Binding DiscordAttachFile}"
                              Content="Also attach the full report as a .txt file" />
                    <Button x:Name="TestWebhookButton" Content="Send test message" HorizontalAlignment="Left"
                            Margin="2,6,0,0" Click="OnTestWebhookClick" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Galaxy Offenders (second webhook)" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <CheckBox Margin="2,2,2,6" IsChecked="{Binding GalaxyEnabled}"
                              Content="Post a Galaxy Offenders bulletin when a grid, script or player keeps causing low sim speed" />
                    <TextBlock Style="{StaticResource Label}" Text="Webhook URL (keep private)" />
                    <TextBox Text="{Binding GalaxyWebhookUrl}" Margin="2" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Bot name" />
                        <TextBox Text="{Binding GalaxyUsername}" Width="200" Margin="2" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Register after (alerts)"
                                   ToolTip="Top result in this many low-sim-speed alerts within the repeat-offender window (days)." />
                        <TextBox Style="{StaticResource NumberBox}" Text="{Binding GalaxyThreshold}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Show grid GPS after (alerts)"
                                   ToolTip="A grid with this many incidents also gets its current GPS position in the bulletin." />
                        <TextBox Style="{StaticResource NumberBox}" Text="{Binding GalaxyGpsThreshold}" />
                    </StackPanel>
                    <Button x:Name="GalaxyTestButton" Content="Send test bulletin" HorizontalAlignment="Left"
                            Margin="2,6,0,0" Click="OnGalaxyTestClick" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Cross-server config sharing" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Label}" Text="Mode"
                                   ToolTip="Off, Follow (take the shared settings) or Publish (write this server's settings). Use Publish on one server only." />
                        <ComboBox Width="140" Margin="2" SelectedValuePath="Content" SelectedValue="{Binding SharedConfigMode, Mode=TwoWay}">
                            <ComboBoxItem Content="Off" />
                            <ComboBoxItem Content="Follow" />
                            <ComboBoxItem Content="Publish" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Shared folder or file (reachable by all servers)" />
                    <TextBox Text="{Binding SharedConfigPath}" Margin="2" />
                    <CheckBox Margin="2,6,2,2" IsChecked="{Binding SharedIncludeDiscord}"
                              Content="Also share webhook URLs and the ping role (turn on for the publisher and the followers)" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="ShareWriteButton" Content="Publish now" Click="OnSharePublishClick"
                                ToolTip="Writes this server's shared settings to the file." />
                        <Button x:Name="ShareReadButton" Content="Pull now" Click="OnSharePullClick"
                                ToolTip="Applies the shared file to this server now." />
                    </StackPanel>
                    <TextBlock x:Name="ShareStatusText" TextWrapping="Wrap" Margin="2,6,2,0" Opacity="0.8" />
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="RunNowButton" Content="Run diagnostics now" Click="OnRunNowClick"
                        ToolTip="Runs the whole sequence immediately, even if the sim speed is fine." />
                <Button Content="Open reports folder" Click="OnOpenReportsClick" />
                <Button Content="Reload from file" Click="OnReloadClick" />
                <Button Content="Re-check Profiler" Click="OnRecheckProfilerClick" />
            </StackPanel>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="2" />
            <TextBlock x:Name="FooterText" Margin="2,14,2,2" Opacity="0.6" FontSize="11" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

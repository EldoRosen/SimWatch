<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <AssemblyName>SimWatch</AssemblyName>
    <RootNamespace>SimWatch</RootNamespace>
    <Version>1.5.1</Version>
    <Title>SimWatch</Title>
    <Product>Torch</Product>
    <DebugType>none</DebugType>
    <!-- Folders containing Torch.dll (Torch install) and Sandbox.Game.dll (DedicatedServer64).
         Override on the command line: -p:TorchDir=... -p:GameDir=... -->
    <TorchDir Condition="'$(TorchDir)' == ''">$(MSBuildThisFileDirectory)TorchBinaries</TorchDir>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)GameBinaries</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\galaxy-offender.png" LogicalName="galaxy-offender.png" />
    <EmbeddedResource Include="Resources\pilot-badge.png" LogicalName="pilot-badge.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="Torch"><HintPath>$(TorchDir)\Torch.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Torch.API"><HintPath>$(TorchDir)\Torch.API.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="NLog"><HintPath>$(TorchDir)\NLog.dll</HintPath><Private>False</Private></Reference>

    <Reference Include="Sandbox.Common"><HintPath>$(GameDir)\Sandbox.Common.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Sandbox.Game"><HintPath>$(GameDir)\Sandbox.Game.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SpaceEngineers.Game"><HintPath>$(GameDir)\SpaceEngineers.Game.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SpaceEngineers.ObjectBuilders"><HintPath>$(GameDir)\SpaceEngineers.ObjectBuilders.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage"><HintPath>$(GameDir)\VRage.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Game"><HintPath>$(GameDir)\VRage.Game.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Library"><HintPath>$(GameDir)\VRage.Library.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Math"><HintPath>$(GameDir)\VRage.Math.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <!-- Release builds produce bin\Release\net48\SimWatch.zip (manifest.xml + SimWatch.dll), ready for Torch's Plugins folder. -->
  <Target Name="PackagePlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <StageDir>$(OutDir)package</StageDir>
      <ZipPath>$(OutDir)SimWatch.zip</ZipPath>
    </PropertyGroup>
    <RemoveDir Directories="$(StageDir)" />
    <MakeDir Directories="$(StageDir)" />
    <Copy SourceFiles="$(OutDir)SimWatch.dll;$(MSBuildProjectDirectory)\manifest.xml" DestinationFolder="$(StageDir)" />
    <Delete Files="$(ZipPath)" />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(ZipPath)" />
    <Message Importance="high" Text="Plugin package: $(ZipPath)" />
  </Target>

</Project>
